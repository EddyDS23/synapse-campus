# ==========================================================
# Synapse Campus — FileStore (almacenamiento de archivos)
# Puerto dev: 9007
# Verifica los nombres de contenedor con `docker ps`:
# Docker DNS es exacto (guion medio != guion bajo).
# Los nombres de variable de este archivo salen de config/*.php:
# si renombras una aquí, renómbrala también en config.
# ==========================================================

APP_NAME=FileStore
APP_ENV=local
# Generar con: php artisan key:generate (nunca vacía)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9007

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de datos (MariaDB 11.4) --------------------------
# DB_HOST = nombre del SERVICIO mariadb en docker-compose
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
# Verifica el nombre real de la BD de FileStore en tu docker-compose
DB_DATABASE=file_store_system
DB_USERNAME=file_store_user
DB_PASSWORD=cambiar
# Deben coincidir con MARIADB_DATABASE / MARIADB_USER / MARIADB_PASSWORD
# / MARIADB_ROOT_PASSWORD del docker-compose.yml

# ---- Sesión / caché / colas --------------------------------
# API sin Redis: todo en archivos. NO dejar "database"
# (los defaults de config son database y rompen sin tablas).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# La clave pública de AuthVault y el token de servicio se cachean aquí
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ---- Almacenamiento de archivos ----------------------------
# Disco donde se guardan los archivos subidos. En Docker, la ruta de
# storage debe ser un VOLUMEN o se pierde al recrear el contenedor.
FILESYSTEM_DISK=local
# Tamaño máximo por archivo, en KB (config/app.php; 5120 = 5 MB)
MAX_FILE_SIZE_KB=5120

# ---- AuthVault (validación de JWT) -------------------------
# Autenticación por guard api (todos los servicios validan RS512)
AUTH_GUARD=api
# Nombre literal del contenedor nginx de AuthVault (dev: guiones medios)
AUTHVAULT_BASE_URL=http://auth-vault-nginx

# ---- Service client (identidad de FileStore en AuthVault) --
# OJO: config/authvault.php lee CLIENT_ID y CLIENT_SECRET
# (sin prefijo AUTHVAULT_). El client_id debe coincidir EXACTO con el
# sembrado por ServiceClientSeeder (guion medio).
# El secret lo imprime el seeder UNA sola vez: cópialo aquí.
CLIENT_ID=file-store
CLIENT_SECRET=

# ---- AuditLog (reporte best-effort) ------------------------
# Nombre literal del contenedor nginx de AuditLog (verifica con docker ps)
# config/auditlog.php solo lee la base URL; la ruta del endpoint
# (/api/internal/events) va fija en el código.
AUDITLOG_BASE_URL=http://audit-log-nginx

# ---- Correo (no se usa) ------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="file-store@synapse.local"
MAIL_FROM_NAME="${APP_NAME}"