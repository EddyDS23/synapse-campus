# ==========================================================
# Synapse Campus — Blade BFF (frontend)
# Este servicio NO usa base de datos: sesiones y caché en archivos.
# ==========================================================

APP_NAME="Synapse Campus"
APP_ENV=local
# Generar con: php artisan key:generate  (nunca dejar vacía)
APP_KEY=
APP_DEBUG=true
# Dev: http://localhost:9006 | Prod: https://synapse.zerofall.qzz.io
APP_URL=http://localhost:9006

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Sin base de datos ------------------------------------
# No se define DB_CONNECTION: el BFF no consulta ninguna BD.
# Todo lo que Laravel suele guardar en "database" va a archivos.

# ---- Sesión (aquí viven los tokens JWT, nunca llegan al browser)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS:
# SESSION_SECURE_COOKIE=true

# ---- Caché (HealthService 30s, tokens por servicio) --------
CACHE_STORE=file

# ---- Colas y otros drivers (no se usan) --------------------
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Correo (no se usa; el envío será de NotificationHub) --
MAIL_MAILER=log

# ==========================================================
# Servicios del ecosistema (comunicación interna Docker)
# Usar el nombre LITERAL del contenedor nginx. Docker DNS es
# exacto: guion bajo vs guion medio importa.
# Red requerida: synapse-campus-network
# ==========================================================

AUTHVAULT_BASE_URL=http://auth_vault_nginx
STUDENTPORTAL_BASE_URL=http://nginx-student-portal
LIBRARYCORE_BASE_URL=http://library_core_nginx
SUPPORTDESK_BASE_URL=http://support_desk_nginx
AUDITLOG_BASE_URL=http://audit_logs_nginx

# Timeout (segundos) para llamadas HTTP a los servicios
HTTP_TIMEOUT=5

# TTL (segundos) del caché de health checks del sidebar
HEALTH_CACHE_TTL=30

# ==========================================================
# OAuth GitHub
# Socialite vive en AuthVault. El callback apunta al BFF:
#   {APP_URL}/auth/github/callback
# Esa misma URL debe estar registrada en la GitHub OAuth App
# y en el GITHUB_REDIRECT_URI de AuthVault.
# ==========================================================