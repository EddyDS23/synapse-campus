# ==========================================================
# Synapse Campus — SupportDesk (mesa de ayuda)
# Puerto dev: 9004
# El nginx de SupportDesk se llama `support_desk_nginx`
# (guion BAJO, por container_name en su docker-compose).
# Docker DNS es exacto: verifica los demás con `docker ps`.
# Los nombres de variable salen de config/*.php: si renombras
# una aquí, renómbrala también en config.
# ==========================================================

APP_NAME=SupportDesk
APP_ENV=local
# Generar con: php artisan key:generate (nunca vacía)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9004

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de datos (MariaDB 11.4) --------------------------
# DB_HOST = nombre del SERVICIO mariadb en docker-compose
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
# Verifica el nombre real de la BD que quieres usar
DB_DATABASE=support_desk_system
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR
# El docker-compose lee estas variables del .env para crear MariaDB:
#   MARIADB_DATABASE=${DB_DATABASE}  MARIADB_USER=${DB_USERNAME}
#   MARIADB_PASSWORD=${DB_PASSWORD}  MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
# Solo se aplican la PRIMERA vez que se crea el volumen mariadb_data.
DB_ROOT_PASSWORD=CAMBIAR
# IMPORTANTE: el healthcheck de mariadb en el compose tiene la contraseña
# root escrita a mano (-p12345678). Debe ser IGUAL a DB_ROOT_PASSWORD o el
# healthcheck falla y `app` nunca arranca (depends_on: service_healthy).

# ---- Sesión / caché / colas --------------------------------
# API sin Redis: todo en archivos. NO dejar "database"
# (los defaults de config son database y rompen sin tablas).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Aquí se cachean la clave pública de AuthVault y el token de servicio
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- AuthVault (validación de JWT y token de servicio) -----
AUTH_GUARD=api
# Nombre literal del contenedor nginx de AuthVault (dev: guiones medios)
AUTHVAULT_BASE_URL=http://auth-vault-nginx
# Las rutas de la clave pública, del token de servicio y del
# security-status van fijas en config/services.php (no son variables).

# ---- Service client (identidad de SupportDesk en AuthVault)
# config/app.php lee CLIENT_ID y CLIENT_SECRET (sin prefijo AUTHVAULT_).
# El client_id debe coincidir EXACTO con el sembrado por el seeder
# de AuthVault (guion medio). El secret lo imprime el seeder UNA vez.
# Scopes del client: audit:events:write, internal:security-status:read
CLIENT_ID=support-desk
CLIENT_SECRET=

# ---- AuditLog (reporte best-effort) ------------------------
# Nombre literal del contenedor nginx de AuditLog (verifica con docker ps)
# La ruta del endpoint (send_events_url) va fija en config/services.php.
AUDITLOG_BASE_URL=http://audit_log_nginx

# ---- Correo (no se usa) ------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@synapse.local"
MAIL_FROM_NAME="${APP_NAME}"
