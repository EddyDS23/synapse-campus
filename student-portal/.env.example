# ==========================================================
# Synapse Campus — StudentPortal (portal académico)
# Puerto dev: 9002
# Verifica los nombres de contenedor con `docker ps`:
# Docker DNS es exacto (guion medio != guion bajo).
# ==========================================================

APP_NAME=StudentPortal
APP_ENV=local
# Generar con: php artisan key:generate (nunca vacía)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9002

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de datos (MariaDB 11.4) --------------------------
# DB_HOST = nombre del SERVICIO mariadb en docker-compose
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=student_portal_system
DB_USERNAME=student_portal_user
DB_PASSWORD=CAMBIAR
# Deben coincidir con MARIADB_DATABASE / MARIADB_USER / MARIADB_PASSWORD
# / MARIADB_ROOT_PASSWORD del docker-compose.yml
# (las MARIADB_* solo se aplican al crear el volumen por primera vez)

# ---- Sesión / caché / colas --------------------------------
# Sin Redis (YAGNI): todo en archivos. NO dejar "database".
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Guarda: clave pública de AuthVault, token de servicio, nombre de profesor
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- AuthVault: validación de JWT --------------------------
# Nombre literal del contenedor nginx de AuthVault (dev: guiones medios)
AUTHVAULT_BASE_URL=http://auth-vault-nginx
AUTHVAULT_PUBLIC_KEY_URL=/api/auth/public-key
# TTL (segundos) del caché de la clave pública
AUTHVAULT_PUBLIC_KEY_CACHE_TTL=3600

# ---- AuthVault: service client (client credentials) --------
# Para pedir token de servicio y resolver el nombre del profesor.
# client_id: el sembrado en AuthVault (ServiceClientSeeder).
# client_secret: el que imprime el seeder UNA sola vez.
AUTHVAULT_SERVICE_TOKEN_URL=/api/service/token
AUTHVAULT_USER_BASIC_INFO_URL=/api/internal/users/{id}/basic-info
AUTHVAULT_CLIENT_ID=student-portal
AUTHVAULT_CLIENT_SECRET=

# ---- AuditLog (reporte best-effort) ------------------------
# Nombre del contenedor nginx de AuditLog (verifica con docker ps)
AUDITLOG_BASE_URL=http://audit-log-nginx
AUDITLOG_EVENTS_URL=/api/internal/events

# ---- Correo (no se usa) ------------------------------------
MAIL_MAILER=log