# ==========================================================
# Synapse Campus — AuthVault (Identity Provider)
# Puerto dev: 9001 | Contenedor nginx: auth_vault_nginx
# ==========================================================

APP_NAME=AuthVault
APP_ENV=local
# Generar con: php artisan key:generate (nunca vacía)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de datos (MariaDB 11.4) --------------------------
# DB_HOST = nombre del servicio mariadb en docker-compose
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=auth_vault_system
DB_USERNAME=auth_vault_user
DB_PASSWORD=cambiar
# (si el compose usa MARIADB_ROOT_PASSWORD / MARIADB_DATABASE /
#  MARIADB_USER / MARIADB_PASSWORD, deben coincidir con lo de arriba)

# ---- Sesión / caché / colas --------------------------------
# AuthVault es API: no usa sesión web.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Redis guarda: rate limiting y sesiones revocadas (session_revoked:{jti}).
# Si fuera "file", un reinicio perdería las revocaciones.
CACHE_STORE=redis
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Autenticación / JWT -----------------------------------
AUTH_GUARD=api

JWT_ALGO=RS512
# Rutas a los PEM. En prod montados como volumen read-only.
JWT_PRIVATE_KEY=file:///var/www/html/storage/certs/private.pem
JWT_PUBLIC_KEY=file:///var/www/html/storage/certs/public.pem
# Solo si la llave privada se generó con passphrase
JWT_PASSPHRASE=
# Access token: 15 minutos
JWT_TTL=15
# Con RS256 NO se usa JWT_SECRET

# ---- Seguridad de login ------------------------------------
# Intentos fallidos antes de bloquear la cuenta (no dejar vacío)
MAX_ATTEMPTS_LOGIN=5

# ---- OAuth GitHub (Socialite) ------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apunta al BFF, no a AuthVault
GITHUB_REDIRECT_URI=http://localhost:9006/auth/github/callback

# ---- AuditLog (reporte best-effort) ------------------------
# Leído como config('services.audit_log.base_url')
AUDITLOG_BASE_URL=http://audit_logs_nginx
AUDITLOG_EVENTS_URL=/api/internal/events

# ---- Correo (no se usa) ------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="auth@synapse.local"
MAIL_FROM_NAME="${APP_NAME}"