cat audit-log.env.example 
# ==========================================================
# Synapse Campus — AuditLog (auditoría centralizada)
# Puerto dev: 9005
# Verifica los nombres de contenedor con `docker ps`:
# Docker DNS es exacto (guion medio != guion bajo).
# ==========================================================

APP_NAME=AuditLog
APP_ENV=local
# Generar con: php artisan key:generate (nunca vacía)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9005

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de datos (MariaDB 11.4) --------------------------
# DB_HOST = nombre del SERVICIO mariadb en docker-compose
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=audit_logs_system
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR
# Deben coincidir con MARIADB_DATABASE / MARIADB_USER / MARIADB_PASSWORD
# / MARIADB_ROOT_PASSWORD del docker-compose.yml

# ---- Sesión / caché / colas --------------------------------
# API sin Redis: todo en archivos. NO dejar "database".
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# La clave pública de AuthVault se cachea aquí
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- AuthVault (validación de JWT) -------------------------
# Nombre literal del contenedor nginx de AuthVault (dev: guiones medios)
AUTHVAULT_BASE_URL=http://auth-vault-nginx
# TTL (segundos) del caché de la clave pública
AUTHVAULT_PUBLIC_KEY_CACHE_TTL=3600
# Solo si tu config/authvault.php lee la ruta desde el .env
# (en StudentPortal estaba fija en config; en SupportDesk era variable):
# AUTHVAULT_PUBLIC_KEY_URL=/api/auth/public-key

# ---- Service client ----------------------------------------
# AuditLog es solo RECEPTOR: no pide tokens de servicio, así que
# NO lleva AUTHVAULT_CLIENT_ID ni AUTHVAULT_CLIENT_SECRET.
# Solo valida los JWT que le llegan con la clave pública.

# ---- Correo (no se usa) ------------------------------------
MAIL_MAILER=log